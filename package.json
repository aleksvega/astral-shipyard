{
  "name": "astral-shipyard",
  "version": "0.1.0",
  "description": "Детерминированный астральный парусник из описания: геометрия, смета, палитра, PNG и GLB. Движок «Астрального Рубежа».",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "three",
    "procedural",
    "ships",
    "sailing",
    "glb",
    "generator"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "public",
    "tools",
    "README.md",
    "LICENSE",
    "SUPPORT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2020 --external:three --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "ship": "node tools/ship-cli.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksvega/astral-shipyard.git"
  },
  "homepage": "https://github.com/aleksvega/astral-shipyard#readme",
  "bugs": {
    "url": "https://github.com/aleksvega/astral-shipyard/issues"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/three": "^0.187.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.50.0",
    "three": "^0.187.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
